POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=contacts_pipeline
POSTGRES_USER=contacts_pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_APP_NAME=stage1-2gis

STAGE1_POLL_INTERVAL_SECONDS=5
STAGE1_HEARTBEAT_INTERVAL_SECONDS=15
STAGE1_STALE_JOB_SECONDS=300
STAGE1_MAX_ATTEMPTS=3
STAGE1_CONSECUTIVE_BROWSER_ERROR_LIMIT=3
STAGE1_BROWSER_TIMEOUT_SECONDS=120
STAGE1_ARTIFACTS_DIR=/var/lib/stage1-2gis/artifacts
STAGE1_DISABLE_IMAGES=1
STAGE1_HEADED=1

PLAYWRIGHT_BROWSERS_PATH=/opt/stage1-2gis/browsers/1.60.0
GOOGLE_APPLICATION_CREDENTIALS=/etc/stage1-2gis/service-account.json
STAGE1_SPREADSHEET_ID=replace-with-google-spreadsheet-id
STAGE1_INPUT_SHEET=Ввод
STAGE1_NEW_DOMAINS_SHEET="NEW domains"

# Google Sheets task planner. These names are intentionally configured, not
# hardcoded, so the planner can target a separately named workbook.
STAGE1_TASKS_SPREADSHEET_ID=replace-with-planning-spreadsheet-id
STAGE1_TASKS_PHRASES_SHEET="Ключевые фразы 2GIS"
STAGE1_TASKS_CITIES_SHEET="Города 2GIS"
STAGE1_TASKS_SUMMARY_SHEET="Сводка 2GIS"
STAGE1_TASKS_RESULTS_SHEET="Результаты 2GIS"
# Optional for restricted networks. The proxy or mirror must allow the
# Playwright browser CDN, not only PyPI.
# HTTPS_PROXY=http://user:password@proxy-host:proxy-port
# PLAYWRIGHT_DOWNLOAD_HOST=https://internal-browser-artifact-mirror.example
