[Unit]
Description=Stage 1 2GIS browser worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=stage1-2gis
Group=stage1-2gis
EnvironmentFile=/etc/stage1-2gis/stage1-2gis.env
WorkingDirectory=/opt/stage1-2gis/current
ExecStart=/usr/bin/xvfb-run -a "--server-args=-screen 0 1280x1024x24 -ac" /opt/stage1-2gis/current/.venv/bin/python -m stage1_2gis browser-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stage1-2gis /opt/stage1-2gis/browsers
StateDirectory=stage1-2gis
UMask=0027

MemoryHigh=2200M
MemoryMax=2800M
CPUQuota=180%
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
